FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm exec -- esbuild server/cloudflare/main.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/cloudflare.js

FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY --from=build /app/dist/cloudflare.js ./dist/cloudflare.js
ENV NODE_ENV=production
USER node
EXPOSE 8080
CMD ["node", "dist/cloudflare.js"]
